DATABASE_URL=postgresql://wechat_user:change-me@127.0.0.1:5432/wechat_assistant
# New Web three-portal tables are created under this schema. Keep legacy WeChat tables in public.
WEB_MVP_SCHEMA=web_mvp
APP_ENV=production
DEPLOY_TARGET=
WORKER_RELEASE=

# Leave empty to disable auth on internal admin APIs. Production should set a long random secret.
API_SECRET=
APP_SESSION_SECRET=
APP_DEBUG_AUTH_CODES=1

# Public H5 deployment split. Recommended production setup:
# - Frontend page on Vercel: https://app.capego.top
# - Backend API on Tencent Cloud: https://api.capego.top
# Let the browser call api.capego.top directly to avoid unstable external rewrites on iPhone WeChat.
NEXT_PUBLIC_API_BASE_URL=https://api.capego.top
BACKEND_PROXY_ORIGIN=
# Public H5 entry URL used in WeChat auto-replies. Set this to the Vercel H5 address when users should open app.capego.top/h5.
WECHAT_H5_ENTRY_URL=https://app.capego.top/h5
H5_CORS_ALLOWED_ORIGINS=https://app.capego.top,http://127.0.0.1:3002,http://localhost:3002
NEXT_PUBLIC_SITE_ICP_NUMBER=
NEXT_PUBLIC_SITE_PSB_NUMBER=
NEXT_PUBLIC_SITE_PSB_URL=https://beian.mps.gov.cn/#/query/webSearch
NEXT_PUBLIC_SITE_PSB_ICON_URL=

# WeChat Official Account server config
WECHAT_TOKEN=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_GROUP_QR_MEDIA_ID=
WECHAT_CONTACT_QR_MEDIA_ID=
WECHAT_SAMPLE_VIDEO_MEDIA_ID=
WECHAT_SAMPLE_COVER_MEDIA_ID=

# Optional fallback worker. The main Tencent Cloud deployment no longer needs this in the primary path,
# but the worker can still be kept as a manual/backfill tool if desired.
WECHAT_MEDIA_WORKER_URL=
WECHAT_MEDIA_WORKER_SECRET=
WECHAT_MEDIA_WORKER_TIMEOUT_MS=10000

# Legacy remote ingest bridge. Keep empty in the Tencent Cloud PostgreSQL deployment.
WECHAT_INGEST_API_URL=
WECHAT_INGEST_API_SECRET=
WECHAT_INGEST_API_TIMEOUT_MS=10000

# Cloudflare R2 config. Fill these four together if you want to use R2 instead of COS.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# Tencent COS config. Fill these instead of the R2 variables for the mainland deployment.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_PUBLIC_BASE_URL=

# Worker runtime secret. Only needed if you still run workers/wechat-media-worker.mjs.
WORKER_SECRET=change-me
START_WECHAT_MEDIA_WORKER=0

# Automatic video analysis worker. The Python environment on the server should install
# scripts/video_qc/requirements.txt before running `npm run worker:video-analysis`.
VIDEO_ANALYSIS_PYTHON_BIN=python3
VIDEO_ANALYSIS_POLL_INTERVAL_MS=5000
VIDEO_ANALYSIS_DOWNLOAD_URL_EXPIRES_IN=3600
VIDEO_ANALYSIS_SAMPLE_FPS=3
VIDEO_ANALYSIS_MIN_WINDOW_HIT_RATIO=0.67
VIDEO_ANALYSIS_PASS_RATIO=0.65
VIDEO_ANALYSIS_REVIEW_RATIO=0.5
VIDEO_ANALYSIS_TIMEOUT_MS=1200000
VIDEO_ANALYSIS_PROVIDER=hybrid
VIDEO_ANALYSIS_DOWNLOAD_RETRIES=5
VIDEO_ANALYSIS_DOWNLOAD_TIMEOUT_SECONDS=300
VIDEO_ANALYSIS_DOWNLOAD_CHUNK_SIZE_MB=4
VIDEO_ANALYSIS_GEMINI_MODEL=gemini-2.5-pro
VIDEO_ANALYSIS_SEGMENT_SECONDS=6
VIDEO_ANALYSIS_SEGMENT_OVERLAP_SECONDS=2
VIDEO_ANALYSIS_GEMINI_CONCURRENCY=3
VIDEO_ANALYSIS_GEMINI_SEGMENT_RETRIES=2
VIDEO_ANALYSIS_GEMINI_FALLBACK_TO_MEDIAPIPE=1
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCS_VIDEO_REVIEW_BUCKET=

# OpenAI asynchronous video review via Batch API. This reviews sampled contact sheets,
# not raw MP4 files directly.
OPENAI_API_KEY=
OPENAI_VIDEO_REVIEW_MODEL=gpt-4.1-mini
OPENAI_VIDEO_BATCH_LIMIT=10
OPENAI_VIDEO_BATCH_MIN_SUBMISSION_ID=380
OPENAI_VIDEO_REVIEW_CONTACT_SHEET_PREFIX=contact-sheet/
OPENAI_VIDEO_REVIEW_IMAGE_URL_EXPIRES_IN=172800
OPENAI_VIDEO_PREP_CONCURRENCY=3
OPENAI_VIDEO_BATCH_SUBMIT_INTERVAL_MS=60000
OPENAI_VIDEO_BATCH_POLL_INTERVAL_MS=60000
OPENAI_VIDEO_REVIEW_MAX_SUBMIT_ATTEMPTS=3
OPENAI_VIDEO_REVIEW_MAX_POLL_ATTEMPTS=3
OPENAI_VIDEO_PREPROCESS_MIN_SUBMISSION_ID=0
OPENAI_VIDEO_PREPROCESS_BATCH_LIMIT=4
OPENAI_VIDEO_PREPROCESS_MAX_ATTEMPTS=3
OPENAI_VIDEO_PREPROCESS_FFPROBE_BIN=ffprobe
OPENAI_VIDEO_PREPROCESS_FFMPEG_BIN=ffmpeg
OPENAI_VIDEO_PREPROCESS_URL_EXPIRES_IN=43200
OPENAI_VIDEO_PREPROCESS_FFMPEG_TIMEOUT_MS=900000
OPENAI_VIDEO_PREPROCESS_CONTACT_SHEET_EDGE=1800
OPENAI_VIDEO_PREPROCESS_JPEG_QUALITY=3
OPENAI_VIDEO_PREPROCESS_COLUMNS=4
OPENAI_VIDEO_PREPROCESS_ROWS=3
FFMPEG_BIN=ffmpeg
